# ShotPilot environment. Copy to .env (never commit .env).

# PostgreSQL connection (local dev). See SETUP_LOCAL.md.
DATABASE_URL=postgres://shotpilot:shotpilot@localhost:5432/shotpilot_dev
# Used by `pnpm test`. The database name MUST end in _test — the test run wipes it.
TEST_DATABASE_URL=postgres://shotpilot:shotpilot@localhost:5432/shotpilot_test

# Script analysis provider: auto | anthropic | heuristic
#   auto      -> Claude when ANTHROPIC_API_KEY is set, otherwise the rule-based parser (no AI)
#   heuristic -> always the rule-based parser
SHOTPILOT_AI_PROVIDER=auto
# Anthropic API key (optional). Get one at https://console.anthropic.com. Keep it secret.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
SHOTPILOT_AI_MODEL=

# Private file storage for uploaded scripts (local disk in development).
# Empty = <app working dir>/.data/uploads (git-ignored).
STORAGE_LOCAL_DIR=
